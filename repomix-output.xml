      <p className="text-sm font-bold tabular-nums text-white">{player.todayPts == null ? "—" : player.todayPts.toFixed(2)}</p>
      <p className="text-[10px] tabular-nums text-[#5e7090]">proj {player.projPts.toFixed(2)}</p>
    </div>
