import { NextResponse } from "next/server"
import { prisma } from "@/lib/prisma"

export async function POST(request: Request) {
  const body = await request.json().catch(() => null) as { managerId?: unknown; pin?: unknown } | null
  if (typeof body?.managerId !== "string" || typeof body.pin !== "string" || !/^\d{4}$/.test(body.pin)) {
    return NextResponse.json({ error: "A manager and 4-digit PIN are required." }, { status: 400 })
  }

  const user = await prisma.user.findUnique({ where: { id: body.managerId } })
  if (!user || user.pin !== body.pin) {
    return NextResponse.json({ error: "Incorrect PIN." }, { status: 401 })
  }

  const team = await prisma.team.findFirst({
    where: { managerId: user.id },
    orderBy: { name: "asc" },
  })
  if (!team) return NextResponse.json({ error: "No team is assigned to this manager." }, { status: 404 })

  const session = JSON.stringify({
    managerId: user.id,
    teamId: team.id,
    handle: user.handle,
    teamName: team.name,
  })
  const response = NextResponse.json({ success: true, teamId: team.id, teamName: team.name })
  response.cookies.set("dynasty_manager", session, {
    httpOnly: true,
    sameSite: "lax",
    secure: process.env.NODE_ENV === "production",
    path: "/",
    maxAge: 60 * 60 * 24 * 30,
  })
  return response
}
</file>

<file path="app/api/auth/session/route.ts">
import { NextResponse } from "next/server"
import { cookies } from "next/headers"
import { prisma } from "@/lib/prisma"

type ManagerSession = {
  managerId: string
  teamId: string
  handle: string
  teamName: string
}

async function readSession(): Promise<ManagerSession | null> {
  const value = (await cookies()).get("dynasty_manager")?.value
  if (!value) return null
  try {
    const session = JSON.parse(value) as Partial<ManagerSession>
    if (
      typeof session.managerId !== "string" ||
      typeof session.teamId !== "string" ||
      typeof session.handle !== "string" ||
      typeof session.teamName !== "string"
    ) return null
    const team = await prisma.team.findFirst({
      where: { id: session.teamId, managerId: session.managerId },
      select: { name: true },
    })
    return team?.name === session.teamName ? session as ManagerSession : null
  } catch {
    return null
  }
}

export async function GET() {
  const user = await readSession()
  return NextResponse.json({ authenticated: Boolean(user), user })
}

export async function DELETE() {
  const response = NextResponse.json({ success: true })
  response.cookies.set("dynasty_manager", "", {
    httpOnly: true,
    sameSite: "lax",
    secure: process.env.NODE_ENV === "production",
    path: "/",
    maxAge: 0,
  })
  return response
}
</file>

<file path="app/api/cron/sync/route.ts">
import { NextRequest, NextResponse } from "next/server"
import { headers } from "next/headers"
import { prisma } from "@/lib/prisma"
import {
  enforceRosterLocks,
  syncActiveGameBoxscores,
  syncScheduleForDate,
  updateWeeklyMatchupScores,
} from "@/lib/services/nhl-sync"

export const runtime = "nodejs"
export const dynamic = "force-dynamic"

async function runSync(request: NextRequest) {
  const startedAt = Date.now()
  const requestHeaders = await headers()
  const configuredSecret = process.env.CRON_SECRET
  const bearerAuthorized = requestHeaders.get("authorization") === `Bearer ${configuredSecret}`
  const queryAuthorized = request.nextUrl.searchParams.get("secret") === configuredSecret
  const developmentBypass = process.env.NODE_ENV === "development"
  if (!bearerAuthorized && !queryAuthorized && !developmentBypass) {
    return NextResponse.json({ error: "Unauthorized" }, { status: 401 })
  }

  const date = new Intl.DateTimeFormat("en-CA", { timeZone: "America/New_York" }).format(new Date())
  const scheduledGames = await syncScheduleForDate(date)
  const processedGames = await syncActiveGameBoxscores()
  await enforceRosterLocks()

  const leagues = await prisma.league.findMany({
    select: { id: true, currentWeek: true },
  })
  for (const league of leagues) {
    await updateWeeklyMatchupScores(league.id, league.currentWeek)
  }

  return NextResponse.json({
    success: true,
    processedGames: Math.max(scheduledGames, processedGames),
    durationMs: Date.now() - startedAt,
  })
}

export async function GET(request: NextRequest) {
  return runSync(request)
}

export async function POST(request: NextRequest) {
  return runSync(request)
}
</file>

