  managerName: string
  handle: string
  teamName: string
  avatar: string
  lastMessage: string
  timestamp: string
  unread: boolean
}

const initialConversations: ConversationMeta[] = [
  { id: "jordan", managerName: "Jordan", handle: "@jordan", teamName: "Toronto Titans", avatar: "JR", lastMessage: "Would you do Hutson for a 2027 1st?", timestamp: "4:15 PM", unread: true },
